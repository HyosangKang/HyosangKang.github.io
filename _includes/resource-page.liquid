<a class="project-back" href="{{ page.back_url | relative_url }}">← {{ page.back_label }}</a>

<div class="resource-meta" aria-label="Resource details">
  <span>{{ page.pathway }}</span>
  {% if page.subject %}
    <span>{{ page.subject }}</span>
  {% elsif page.area %}
    <span>{{ page.area }}</span>
  {% endif %}
</div>

{% assign media_key = page.path | split: '/' | last | remove: '.md' %}
{% assign media = site.data.project_media[media_key] %}

<section class="resource-section">
  <h2>Question</h2>
  <p class="resource-question">{{ page.question }}</p>
</section>

<div class="project-gallery">
  {% unless media.source_only %}
    <figure class="project-image">
      <img
        src="{{ '/assets/img/projects/' | append: media_key | append: '.png' | relative_url }}"
        alt="{{ page.visual_caption | escape }}"
        loading="lazy"
        decoding="async"
      >
      <figcaption>{{ page.visual_caption }}</figcaption>
    </figure>
  {% endunless %}
  {% for image in media.source_images %}
    <figure class="project-image project-source-image">
      <img src="{{ image.src | relative_url }}" alt="{{ image.alt | escape }}" loading="lazy" decoding="async">
      <figcaption>{{ image.caption }}</figcaption>
    </figure>
  {% endfor %}
</div>

<section class="resource-section">
  <h2>Goals</h2>
  <ul>
    {% for goal in page.goals %}
      <li>{{ goal }}</li>
    {% endfor %}
  </ul>
</section>

<section class="resource-section">
  <h2>Method</h2>
  {% if page.method_intro %}
    <p>{{ page.method_intro }}</p>
  {% endif %}
  <ul>
    {% for item in page.method %}
      <li>{{ item }}</li>
    {% endfor %}
  </ul>
</section>

{% if media.examples %}
  <section class="resource-section">
    <h2>Try an example</h2>
    <div class="project-examples">
      {% for example in media.examples %}
        <article class="project-example">
          <div class="project-example-heading">
            <h3>{{ example.title }}</h3>
            <div class="project-example-actions">
              {% if example.source_url %}
                <a href="{{ example.source_url }}" target="_blank" rel="noopener">Source code ↗</a>
              {% endif %}
              <a href="{{ example.src | relative_url }}" target="_blank" rel="noopener">Open full screen ↗</a>
            </div>
          </div>
          <p>{{ example.description }}</p>
          <iframe
            class="interactive-frame"
            src="{{ example.src | relative_url }}"
            title="{{ example.title | escape }} interactive example"
            loading="lazy"
            style="aspect-ratio: {{ example.aspect_ratio }};"
            allow="fullscreen"
          ></iframe>
          <p class="example-instructions"><strong>Controls:</strong> {{ example.instructions }}</p>
        </article>
      {% endfor %}
    </div>
  </section>
{% endif %}
