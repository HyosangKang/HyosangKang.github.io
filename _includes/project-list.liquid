{% assign project_items = site.learning_projects | where: 'subject_slug', include.subject | sort: 'project_order' %}

<div class="project-grid">
  {% for project in project_items %}
    <a class="project-card" href="{{ project.url | relative_url }}">
      <span class="project-number">{{ project.project_order | prepend: '0' | slice: -2, 2 }}</span>
      <h2>{{ project.title }}</h2>
      <p>{{ project.description }}</p>
      <span class="project-link">Open project page →</span>
    </a>
  {% endfor %}
</div>
